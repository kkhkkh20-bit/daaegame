      "factor": 0.5,
      "attack_ms": 120,
      "release_ms": 300,
      "scope": "whole speaking line, never per blip"
    },
    "event_duck": {
      "factor": 0.4,
      "attack_ms": 70,
      "hold_ms": 450,
      "release_ms": 350
    },
    "maximum_foreground_cues": 2,
    "typing_not_counted_but_suppressed_by_major_events": true,
    "priority_rule": "Larger priority wins within a channel; drop lower priority arriving while a higher cue is active. Do not queue stale UI/typing sounds.",
    "confirm_rule": "Suppress generic confirm when the same committed action emits a semantic cue.",
    "acquisition_batch_rule": "One cue per newly added batch, not every rotating card.",
    "history_and_hover": "always silent",
    "on_menu_or_load": "stop typing; suppress newly fired cues; do not replay when dismissed",
    "variant_rule": "cycle a,b,c only on audible glyph event; never update on redraw",
    "audio_unlock": "only after actual user gesture; no unsolicited autoplay",
    "mix_acceptance": "max true peak -3 dBTP at normal settings; clipping 0; actual device listening required",
    "values_are_starting_points": true
  }
