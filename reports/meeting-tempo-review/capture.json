  "log": [
    {
      "t": 78334.685608229,
      "say": "부엉이 어르신이 발견된 13호는 안에서 잠겨 있었습니다.\n그 안에는 다람 양이 있었습니다."
    },
    {
      "t": 78335.415713844,
      "say": "그냥 ‘발견된 사람’처럼 말하지 마세요.\n우리 할아버지예요."
    },
    {
      "t": 78336.105386257,
      "say": "오늘 확인할 것은 아이가 그 죽음에 책임이 있는지입니다.\n소문을 본 일처럼 말하지 마십시오."
    },
    {
      "t": 78336.786217015,
      "say": "아이가 위험하다면 마을의 다른\n아이들부터 지켜야 합니다."
    },
    {
      "t": 78337.480720102,
      "say": "아이가 위험하다는 판단도 확인된\n사실에 근거해 주십시오."
    },
    {
      "t": 78339.131283658,
      "say": "아이가 겁을 먹은 건 알겠습니다.\n하지만 아이에게 맞은 사람이 죽었습니다."
    },
    {
      "t": 78339.800662103,
      "say": "할아버지가 먼저 아이 손을 잡았다는 말도 지금은 들을게요.\n그다음엔 무슨 일이 있었는데요?"
    },
    {
      "t": 78355.12988517,
      "say": "검사원님과 깨진 면을 상처에 맞춰 본 기록입니다.\n머리의 상처는 갈라진 윗부분의 안쪽 날과 모양이 맞습니다."
    },
    {
      "t": 78355.787703369,
      "say": "그 안쪽 날은 촛대가 붙어 있을 때는 드러나지 않습니다."
    },
    {
      "t": 78356.45593112,
      "say": "촛대가 부러진 다음에, 누군가 그\n윗부분 조각을 다시 들었다는 뜻입니다."
    },
    {
      "t": 78357.694054795,
      "say": "정말요?"
    },
    {
      "t": 78358.388432874,
      "say": "그렇다고요?"
    },
    {
      "t": 78359.090097572,
      "say": "잠깐, 끝까지 들어봐요."
    },
    {
      "t": 78375.194075754,
      "say": "촛대가 떨어진 뒤 촛농을 밟고 통로\n쪽으로 돌아간 발자국이 있습니다."
    },
    {
      "t": 78375.89672465,
      "say": "그 위로 피가 번졌습니다.\n촛대가 떨어진 다음에도 그 방에 다른 사람이 있었다는 뜻입니다."
    },
    {
      "t": 78376.566067887,
      "say": "……그럼 할아버지를 친 사람이 따로 있다는 거예요?"
    },
    {
      "t": 78377.674721886,
      "say": "정말요?"
    },
    {
      "t": 78378.393145242,
      "say": "그렇다고요?"
    },
    {
      "t": 78385.924927106,
      "say": "그럼 그 통로로 아이가 직접\n나갔다가 들어왔을 수도 있잖습니까?"
    },
    {
      "t": 78392.74930655,
      "say": "겁 많은 아이가 촛대는 휘둘렀다지 않소?"
    },
    {
      "t": 78393.412460033,
      "say": "(내 말이 그대로 되돌아왔다.\n자료는 맞다."
    },
    {
      "t": 78394.060083854,
      "say": "답을 다시 생각해 보자.)"
    },
    {
      "t": 78394.723552705,
      "say": "그 질문에는 아직 답하지 못했어요."
    }
  ],
