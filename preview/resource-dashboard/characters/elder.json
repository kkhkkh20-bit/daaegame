daram\":return store.room13[\"location\"] if r13_home_with_daram() else None\n        return _r13_home_where(person)"},{"name":"r13_resident_where","source":{"path":"experiments/renpy-ch1/game/room13_life.rpy","line":164},"code":"    def r13_resident_where(person):\n        if person not in R13_RESIDENTS:return None\n        s=store.room13\n        if person==\"resident_piko\" and s[\"day\"]>=R13_WEEK2_DAY:return \"clinic\"\n        if person==\"resident_badook\" and s[\"day\"]>=R13_WEEK2_DAY and r13_has(\"patient_transport\"):return \"school\"\n        if s[\"day\"]>=r13_tl(11) and r13_has(\"shelter_ready\") and person in (\"resident_tori\",\"resident_yeoni\",\"resident_kongi\",\"resident_somi\",\"resident_musoe\"):\n            return \"school\"\n        where=R13_WEEKLY_ROUTINES.get(person,R13_RESIDENTS[person][\"weekly_locations\"])[(s[\"day\"]-1)%7][min(s[\"period\"],2)]\n        return {\"home\":None,\"library\":\"post\",\"lowroad\":\"gate\",\"tower\":\"square\"}.get(where,where)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/room13_rules.rpy","line":223},"code":"    def r13_where(person):\n        s=store.room13; p=min(s[\"period\"],2)\n        if s[\"day\"]>=R13_WEEK2_DAY:return r13_w2_where(person)\n        if person==\"resident_owlgp\":\n            if s[\"victim_state\"]==\"dead\":return None\n            return (\"square\",\"inn\",\"dining\")[p]\n        if person==\"granny\":return None if s[\"granny_state\"]==\"detained\" else \"inn\"\n        if person==\"nabi\":return r13_nabi_daily_where(s)\n        if person==\"buri\":return \"workshop\"\n        if person==\"karo\":return \"gate\"\n        if person==\"seryeon\":return \"post\" if s[\"day\"]>=2 and p<2 else None\n        if person==\"resident_tok\":return \"workshop\" if p<2 else \"dining\"\n        if person==\"resident_lamplighter\":return (\"workshop\",\"square\",\"gate\")[p]\n        if person==\"doto\":return \"hall\" if s[\"day\"]>=R13_CASE_DAY+1 else \"square\"\n        if person==\"bami\":\n            if s[\"case_state\"]!=\"occurred\":return None\n            return \"inn\" if r13_has(\"bami_protected\") else \"hall\" if p>0 else None\n        if person==\"neoul\":return \"gate\" if s[\"case_state\"]==\"occurred\" else None\n        if person==\"resident_seori\":return \"clinic\"\n        return r13_resident_where(person)"},{"name":"r13_w2_where","source":{"path":"experiments/renpy-ch1/game/room13_week2_rules.rpy","line":144},"code":"    def r13_w2_where(person):\n        s=store.room13;p=min(s[\"period\"],2)\n        if person==\"mom\":return \"greenhouse\" if r13_has(\"mom_reunited\") else None\n        if person==\"granny\":return None if s[\"granny_state\"]==\"detained\" else \"inn\"\n        if person==\"resident_owlgp\":return \"school\" if s[\"victim_state\"]!=\"dead\" else None\n        if person==\"nabi\":\n            if s[\"granny_state\"]==\"detained\" and p==0:return \"inn\"\n            return \"school\" if r13_has(\"shelter_ready\") else r13_nabi_daily_where(s)\n        if person==\"buri\":return \"workshop\"\n        if person==\"resident_tok\":return \"workshop\" if p<2 else \"school\"\n        if person==\"resident_seori\":return (\"clinic\",\"store\",\"school\")[p]\n        if person==\"resident_lamplighter\":return (\"square\",\"workshop\",\"gate\")[p]\n        if person==\"resident_eunho\":return \"store\"\n        if person==\"resident_teacher\":return \"school\"\n        if person==\"resident_bori\":return (\"school\",\"store\",\"gate\")[p]\n        if person==\"resident_nubi\":return \"school\" if r13_has(\"nubi_protected\") else (\"facility\",\"inn\",\"school\")[p]\n        if person==\"neoul\":return \"facility\"\n        if person==\"karo\":return \"gate\"\n        if person==\"seryeon\":return \"post\" if p<2 else None\n        if person==\"doto\":return \"hall\"\n        if person==\"bami\":return \"inn\" if r13_has(\"bami_protected\") else \"hall\" if p>0 else None\n        return r13_resident_where(person)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_alibi.rpy","line":30},"code":"    def r13_where(person):\n        s=store.room13 or {}\n        pins=R13_STORY_PINS.get((s.get(\"day\"),min(s.get(\"period\",0),2)))\n        if pins and person in pins:return pins[person]\n        return _r13_alibi_where(person)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_ep2_kids.rpy","line":92},"code":"    def r13_where(person):\n        if person==\"resident_musoe\":\n            if r13_has(\"musoe_gone\"):return None\n            if r13_has(\"kd_seori\"):return \"clinic\"\n        return _r13_kd_where(person)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_ep4_night13.rpy","line":34},"code":"    def r13_where(person):\n        if person==\"resident_lamplighter\":\n            if r13_has(\"chorong_dead\"):return None\n            if r13_has(\"nt_chorong_half\") and r13_has(\"nt_night8\"):return \"clinic\"\n        if person==\"resident_ttadak\":\n            if r13_has(\"ttadak_dead\"):return None\n            if r13_has(\"nt_ttadak_half\") and r13_has(\"nt_dawn9\"):return \"clinic\"\n        return _r13_nt_where(person)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_episodes.rpy","line":55},"code":"    def r13_where(person):\n        if person==\"bami\" and r13_has(\"bami_taken\"):return None\n        if person==\"resident_tok\" and r13_has(\"tok_detained\") and not r13_has(\"tok_cleared\"):return None\n        return _r13_episode_where(person)"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_livelihood_flow.rpy","line":107},"code":"    def r13_where(person):\n        if person==\"karo\" and store.room13.get(\"day\")==2 and not r13_has(\"livelihood_open\"):\n            return \"gate\"\n        return _r13_life_where(person)"},{"name":"r13_resident_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_new_places.rpy","line":105},"code":"    def r13_resident_where(person):\n        where=_r13_new_places_resident_where(person)\n        place=r13_new_place_for(person)\n        # Only the plain weekly slot moves; a special case above (clinic, shelter) wins.\n        if place and where==R13_RAW_SLOT_PLACE.get(r13_raw_weekly_slot(person),r13_raw_weekly_slot(person)):return place\n        return where"},{"name":"r13_where","source":{"path":"experiments/renpy-ch1/game/systems/room13_story_continuity.rpy","line":19},"code":"    def r13_where(person):\n        flag=R13_DEATH_FLAGS.get(person)\n        if flag and store.room13 and r13_has(flag):return None\n        return _r13_continuity_where(person)"}],"captures":[],"schedule_source":{"path":"experiments/renpy-ch1/game/room13-content.json","line":1,"pointer":"/residents/elder/weekly_locations"}}
