    "gate_list": [
      {"scene": "S02"},
      {"id": "MS14_D01_S02_L0019", "who": "doc", "t": "초소 입장 명단: 같은 도착일 / 다돌 / 신청 2명 / 신규 일꾼 본인 1명 / 동행 아동 모집 제외 / 내일부터 장작 운반 / 처리 너울."},
      {"id": "NW_D01_S02_A02", "who": "narr", "t": "명단 뒤에 작은 종이가 따로 붙어 있다. “여관에 먼저 연락.” 명단과 글씨체가 다르다."},
      {"get": "E02"},
      {"id": "NW_D01_S02_V02", "who": "dad", "t": "(다람이 이름은 어디 있지?)"},
      {"id": "MS14_D01_S02_L0020", "who": "dad", "fx": "jolt", "t": "장작?{w=.3} 장작 운반이요?{w=.4}\n그런 거 신청한 적 없습니다."},
      {"id": "MS14_D01_S02_L0021", "who": "guard", "t": "그러니 신청서를 찾아 보시오.{w=.3} 신청서대로라면 고쳐 주겠소."},
      {"id": "MS14_D01_S02_L0022", "who": "narr", "t": "어떤 자료부터 보여 줄까?"},
      {"goto": "gate_choice"}
