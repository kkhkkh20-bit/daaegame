    "gate_investigate": [
      {
        "if": "v('gate_wrong_pending')",
        "then": [
          {"set": {"gate_wrong_pending": false}},
          {
            "if": "not has('E03') or not has('E04')",
            "then": [
              {"who": "dad", "t": "(아직 이 창구에서 확인하지 않은 서류가 있다. 돌목 씨가 내놓은 것부터 직접 읽어 보자.)"}
            ],
            "else": [
              {
                "if": "v('tries:gate') == 1",
                "then": [
