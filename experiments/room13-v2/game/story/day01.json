                ],
                "else": [
                  {
                    "if": "v('tries:gate') == 2",
                    "then": [
                      {"who": "dad", "t": "(돌목 씨는 명부에 내 이름만 일꾼으로 올랐다고 한다. ……우리가 일하러 왔다는 말부터 맞지 않잖아.)"}
                    ],
                    "else": [
                      {"who": "dad", "t": "(오늘 이 창구에서 본 적힌 것들이다. 우리가 무엇으로 왔는지, 규칙은 무엇이라 하는지.)"}
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
