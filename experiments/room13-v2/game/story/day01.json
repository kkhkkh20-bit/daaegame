    "S02": {"title": "2. 초소 / 한 사람의 허가", "time_place": "1일 도착 / 초소 입구→내부", "goal": "마을에 들어가려면 무엇을 확인받아야 할까?", "music": "bgm-snow", "ambience": "wind"},
