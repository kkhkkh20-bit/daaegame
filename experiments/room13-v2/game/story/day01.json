    "registered": [
      {"scene": "S04"},
      {"id": "MS14_D01_S04_L0002", "who": "daram", "e": "anxious", "t": "아빠……{w=.3} 아직도 기다려?"},
      {"id": "MS14_D01_S04_L0003", "who": "guard", "t": "이름 적는 동안만.{w=.3} 조금만."},
      {"id": "MS14_D01_S04_L0004", "who": "dad", "t": "둘 다……{w=.3} 들어가는 거죠?"},
      {"id": "MS14_D01_S04_L0005", "who": "guard", "t": "그렇소. 방문객 다돌.{w=.3} 같이 온 아이는……{w=.4} 이름이?"},
      {"id": "MS14_D01_S04_L0006", "who": "daram", "e": "angry", "fx": "jolt", "t": "다람!{w=.3} 내 이름은 다람이야."},
      {"id": "MS14_D01_S04_L0008", "who": "guard", "t": "……다람.{w=.4} 됐소."},
      {"get": "E05"},
