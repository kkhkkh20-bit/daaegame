    def _g2_set(key,**kw):
        if key in ROOM13["topics"]:
            ROOM13["topics"][key].update(kw)

    def _g2_day(s):
        return s.get("day",1)

    def _g2_with_child(s):
        return s.get("daram_state") in ("with_dad","rescued")

    def _g2_held(s):
        return s.get("daram_state")=="held"

    def _g2_read_before_today(key):
        def test(s):
            stamp=s.get("dialogue_dates",{}).get(key)
            return bool(stamp) and stamp.get("day",0)<s.get("day",1)
        return test

