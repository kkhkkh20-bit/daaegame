    #   수선 일을 묻고, 여니가 토리가 자기 제자임을 먼저 말하게 한다(CAST_BIBLE: 여니가 거둔 제자).
    if _rv3_retitle("life:resident_yeoni:after","요즘 수선 일은 어떻습니까?","수선 일이 요즘 어떤지 묻는다"):
        _rv3_variants("life:resident_yeoni:after",[(None,[
            ("dad","요즘 수선 일은 어떻습니까?"),
