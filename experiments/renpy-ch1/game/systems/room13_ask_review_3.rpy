# 0.19.x 전체 선택지 검수 3 (소유자 2026-10-17): "미리 뭘 안다는 게 불가해. 질문 선택지부터 해서
#   그런 것들 다 검수해서 제대로 만들어 줘. 말이 되게끔. 사용자가 당황해."
#   범위: 실룩·엄마·여니·우박·은호 사장·종종이·초롱·칼바람·콩이·토리·토실·톡·피코·할머니·현이의 질문.
#   기준: 선택지가 처음 목록에 나올 수 있는 가장 이른 순간에 아빠가 아는 것만 전제한다.
#         묻는 말과 답이 맞물려야 하고, 아직 이름을 모르는 사람을 이름으로 부르지 않는다.
#   틀: systems/room13_threads.rpy (steps / variants / again). 기존 steps는 {"all":[기존, 새 조건]}으로 합친다.
#   조건은 dict로만 쓴다(람다 금지). 정본에 없는 새 사실은 만들지 않는다.
init 200 python:
    _RV3_TH={"thought":True}

    def _rv3_steps(key,cond):
        t=ROOM13["topics"].get(key)
        if t is None:return False
        old=t.get("steps")
        t["steps"]={"all":[old,cond]} if old else cond
        return True

    def _rv3_retitle(key,title,summary):
        t=ROOM13["topics"].get(key)
        if t is None:return False
        t["title"]=title
        R13_QUESTION_SUMMARIES[title]=summary
        return True

    def _rv3_variants(key,rows):
        t=ROOM13["topics"].get(key)
        if t is None:return False
        t["variants"]=list(rows)
        return True

    # ================================================================= 알리바이(첫날 밤): 제목과 첫 대사를 맞춘다
