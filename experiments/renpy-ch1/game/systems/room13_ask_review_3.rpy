    # "흰 토끼 아이" 이야기만 듣고도 열려서, 아직 모르는 토실의 이름이 제목에 먼저 나왔다.
    # 장면형 주제(r13_alibi_topic)라 제목만 바꾼다(대사는 앞 층에서 이미 금요일로 고쳐져 있다).
    _rv3_retitle("alibi:night1:granny","저희가 온 금요일 밤, 어디 계셨습니까?","도착한 금요일 밤에 어디 있었는지 묻는다")
    _rv3_retitle("alibi:night1:resident_hyeoni","저희가 온 금요일 밤, 어디 계셨습니까?","도착한 금요일 밤에 어디 있었는지 묻는다")
    _rv3_retitle("alibi:night1:resident_tosil","우리가 온 금요일 밤엔 뭐 했니?","도착한 금요일 밤에 뭘 했는지 묻는다")

    # ================================================================= 우박
