    # 빌려 간 온도계(L02)만으로 열렸다. 쪽지를 본 뒤에만 연다(이미 읽었으면 그대로 둔다).
    _rv3_steps("ep1:ubak",{"any":[{"has":["L03"]},{"has":["ep1:ubak"]}]})

