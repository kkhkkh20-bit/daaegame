    "sleeve": {
      "title": "팔이 안 빠져요",
      "owner": "resident_tori",
      "source_place": "inn",
      "source_day": 2,
      "source_periods": [
        0,
        1
      ],
      "members": [
        "resident_yeoni",
        "resident_tori"
      ],
      "notice": "토리가 소매를 잡고 있고, 여니가 안쪽 실밥을 살피고 있다.",
      "source_title": "소매가 걸렸니?",
      "memory_title": "소매는 이제 편하니?",
      "passed_title": "요즘은 뭐 하니?",
      "choices": [
        {
          "title": "제가 이쪽 천을 잡을게요.",
          "result": "help"
        },
        {
          "title": "잠깐 옆에서 볼게요.",
          "result": "watch"
        },
        {
          "title": "지금은 도와드리기 어렵겠어요.",
          "result": "decline"
        }
      ],
      "blocks": {
        "intro": [
          {
            "id": "VL147_SEAM_INTRO_01",
            "speaker": "아빠",
            "text": "소매가 걸렸니?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_INTRO_02",
            "speaker": "토리",
            "text": "손을 빼려는데 안 빠져요. 잠깐만요. 그쪽 잡아당기면 더 걸려요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_INTRO_03",
            "speaker": "여니",
            "text": "알았어. 조금만 느슨하게 해 보자.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_INTRO_04",
            "speaker": "다람",
            "text": "아빠, 손이 갇혔어.",
            "expression": "neutral",
            "kind": "dialogue",
            "companion": true
          },
          {
            "id": "VL147_SEAM_INTRO_05",
            "speaker": "아빠",
            "text": "손목은 괜찮니?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_INTRO_06",
            "speaker": "토리",
            "text": "네. 천만 걸린 거예요.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "help": [
          {
            "id": "VL147_SEAM_HELP_01",
            "speaker": "아빠",
            "text": "제가 이쪽 천을 잡을게요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_HELP_02",
            "speaker": "여니",
            "text": "고맙습니다. 토리야, 손목을 조금 돌려 봐.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_HELP_03",
            "speaker": "토리",
            "text": "나왔어요. 다음에는 제 팔부터 넣어 보고 꿰매요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_HELP_04",
            "speaker": "여니",
            "text": "그래. 선만 곧게 맞추느라 너무 좁게 잡았네.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_HELP_05",
            "speaker": "다람",
            "text": "내 장갑도 벗을 때 손가락이 뒤집혀.",
            "expression": "neutral",
            "kind": "dialogue",
            "companion": true
          },
          {
            "id": "VL147_SEAM_HELP_08",
            "speaker": "아빠",
            "text": "그 장갑은 아빠가 같이 펴 줄게.",
            "expression": "neutral",
            "kind": "dialogue",
            "companion": true
          },
          {
            "id": "VL147_SEAM_HELP_06",
            "speaker": "아빠",
            "text": "그럼 이 소매는 조금 더 넓혀야겠네요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_HELP_07",
            "speaker": "여니",
            "text": "네. 손부터 뺐으니, 이제 안쪽을 다시 손봐야죠.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "watch": [
          {
            "id": "VL147_SEAM_WATCH_01",
            "speaker": "아빠",
            "text": "잠깐 옆에서 볼게요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_WATCH_02",
            "speaker": "여니",
            "text": "토리야, 천을 반대로 젖혀 볼까?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_WATCH_03",
            "speaker": "토리",
            "text": "이렇게요? 아, 이 실이 잡고 있었네요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_WATCH_04",
            "speaker": null,
            "text": "여니가 안쪽 실밥을 조금 푼다. 토리가 손을 빼고 손목을 돌린다.",
            "expression": "neutral",
            "kind": "narration"
          },
          {
            "id": "VL147_SEAM_WATCH_05",
            "speaker": "여니",
            "text": "입고 벗는 걸 먼저 봤어야 했네.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_WATCH_06",
            "speaker": "아빠",
            "text": "풀어 놓은 실은 괜찮나요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_WATCH_07",
            "speaker": "여니",
            "text": "다시 꿰매면 돼요. 팔이 걸리는 것보다는 낫죠.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "decline": [
          {
            "id": "VL147_SEAM_DECLINE_01",
            "speaker": "아빠",
            "text": "지금은 도와드리기 어렵겠어요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_DECLINE_02",
            "speaker": "여니",
            "text": "괜찮아요. 토리야, 이 실만 풀자. 천은 잡아당기지 말고.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_DECLINE_03",
            "speaker": "토리",
            "text": "네. 이쪽부터요.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_help": [
          {
            "id": "VL147_SEAM_MEMORY_HELP_01",
            "speaker": "아빠",
            "text": "소매는 이제 편하니?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_HELP_02",
            "speaker": "토리",
            "text": "네. 잡아 주셔서 손이 빠졌잖아요. 이번에는 혼자 벗었어요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_HELP_03",
            "speaker": "아빠",
            "text": "안쪽 실은 다시 손봤고?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_HELP_04",
            "speaker": "토리",
            "text": "여니가 조금 풀었어요. 아직 마무리는 해야 한대요.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_watch": [
          {
            "id": "VL147_SEAM_MEMORY_WATCH_01",
            "speaker": "아빠",
            "text": "소매는 이제 편하니?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_WATCH_02",
            "speaker": "토리",
            "text": "네. 그때 여니가 실을 풀어 줘서 이제 손이 안 걸려요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_WATCH_03",
            "speaker": "아빠",
            "text": "입어 보고 손보니까 다르구나.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_WATCH_04",
            "speaker": "토리",
            "text": "다음에도 꿰매기 전에 꼭 입어 볼 거예요.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_decline": [
          {
            "id": "VL147_SEAM_MEMORY_DECLINE_01",
            "speaker": "아빠",
            "text": "소매는 이제 편하니?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_DECLINE_02",
            "speaker": "토리",
            "text": "네. 여니랑 안쪽 실을 풀었어요. 이렇게 하면 안 걸려요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_DECLINE_03",
            "speaker": "아빠",
            "text": "잘됐네. 손목은 괜찮고?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_SEAM_MEMORY_DECLINE_04",
            "speaker": "토리",
            "text": "괜찮아요. 세게 안 당겼거든요.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "passed": [
          {
            "id": "VL147_SEAM_PASSED_01",
            "speaker": "아빠",
            "text": "요즘은 뭐 하니?",
            "expression": "neutral",
            "kind": "dialogue"
