      ],
      "notice": "부엉이 할아버지가 엽서 한 장을 앞에 두고 세련과 이야기하고 있다.",
      "source_title": "엽서를 쓰시는 중이세요?",
      "memory_title": "엽서는 보내셨어요?",
      "passed_title": "지금은 쉬시는 중이세요?",
      "choices": [
        {
          "title": "안부부터 물어보시면 어떨까요?",
          "result": "help"
        },
        {
          "title": "천천히 쓰세요. 기다릴게요.",
          "result": "watch"
        },
        {
          "title": "저는 제 용건부터 보겠습니다.",
          "result": "decline"
        }
      ],
      "blocks": {
        "intro": [
          {
            "id": "VL147_POST_INTRO_01",
            "speaker": "아빠",
            "text": "엽서를 쓰시는 중이세요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_INTRO_02",
            "speaker": "부엉이",
            "text": "그래. 보내려는 사람 이름은 아는데, 여기에 쓰려니 손이 안 가네.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_INTRO_03",
            "speaker": "세련",
            "text": "인사말을 벌써 세 번 고치셨어요. 주소는 다 적으셨고요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_INTRO_04",
            "speaker": "부엉이",
            "text": "오래간만에 보내는데, 볼일도 없이 잘 지내냐고만 해도 될까 싶어서.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "help": [
          {
            "id": "VL147_POST_HELP_01",
            "speaker": "아빠",
            "text": "안부부터 물어보시면 어떨까요? 답장이 와야 어떻게 지내는지도 알죠.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_HELP_02",
            "speaker": "부엉이",
            "text": "그렇겠지. 쓰지도 않고 답부터 걱정했구먼.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_HELP_03",
            "speaker": "세련",
            "text": "그럼 지우개는 잠깐 제가 갖고 있을게요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_HELP_04",
            "speaker": "부엉이",
            "text": "그건 돌려줘. 이름 틀리면 안 되잖나.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "watch": [
          {
            "id": "VL147_POST_WATCH_01",
            "speaker": "아빠",
            "text": "천천히 쓰세요. 기다릴게요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_WATCH_02",
            "speaker": null,
            "text": "할아버지가 지우개를 엽서 옆에 놓는다. 한 줄을 쓰고, 이번에는 지우지 않는다.",
            "expression": "neutral",
            "kind": "narration"
          },
          {
            "id": "VL147_POST_WATCH_03",
            "speaker": "부엉이",
            "text": "기다리게 했네. 다 썼어.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_WATCH_04",
            "speaker": "아빠",
            "text": "이제 부치시면 되겠네요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_WATCH_05",
            "speaker": "부엉이",
            "text": "응. 여기서 더 붙들고 있으면 또 고칠 테니.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "decline": [
          {
            "id": "VL147_POST_DECLINE_01",
            "speaker": "아빠",
            "text": "저는 제 용건부터 보겠습니다.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_DECLINE_02",
            "speaker": "세련",
            "text": "네. 말씀하세요. 엽서는 천천히 쓰셔도 되니까요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_DECLINE_03",
            "speaker": "부엉이",
            "text": "그래, 먼저 보게. 난 한 줄만 더 쓰면 돼.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_help": [
          {
            "id": "VL147_POST_MEMORY_HELP_01",
            "speaker": "아빠",
            "text": "엽서는 보내셨어요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_HELP_02",
            "speaker": "부엉이",
            "text": "보냈지. 자네 말 듣고 안부만 적었어.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_HELP_03",
            "speaker": "아빠",
            "text": "답장 기다리시겠네요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_HELP_04",
            "speaker": "부엉이",
            "text": "이제는 그래도 기다릴 게 생겼네.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_watch": [
          {
            "id": "VL147_POST_MEMORY_WATCH_01",
            "speaker": "아빠",
            "text": "엽서는 보내셨어요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_WATCH_02",
            "speaker": "부엉이",
            "text": "응. 자네 앞에서 쓴 그대로 보냈어. 혼자 있었으면 또 지웠을 거야.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_WATCH_03",
            "speaker": "아빠",
            "text": "끝까지 쓰셨으니 다행입니다.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_WATCH_04",
            "speaker": "부엉이",
            "text": "다음에는 지우개를 두고 와야겠어.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "memory_decline": [
          {
            "id": "VL147_POST_MEMORY_DECLINE_01",
            "speaker": "아빠",
            "text": "엽서는 보내셨어요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_DECLINE_02",
            "speaker": "부엉이",
            "text": "부쳤어. 세련이 창구 닫기 전에 달라길래 얼른 줬지.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_DECLINE_03",
            "speaker": "아빠",
            "text": "다 쓰셨군요.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_MEMORY_DECLINE_04",
            "speaker": "부엉이",
            "text": "그래. 계속 들고 있을 수도 없으니까.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
        "passed": [
          {
            "id": "VL147_POST_PASSED_01",
            "speaker": "아빠",
            "text": "지금은 쉬시는 중이세요?",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_PASSED_02",
            "speaker": "부엉이",
            "text": "응. 우체국에 엽서를 부쳤어. 한 장 쓰는 데 한참 걸렸지.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_PASSED_03",
            "speaker": "아빠",
            "text": "쓰실 말씀이 많으셨나 봅니다.",
            "expression": "neutral",
            "kind": "dialogue"
          },
          {
            "id": "VL147_POST_PASSED_04",
            "speaker": "부엉이",
            "text": "아니. 잘 지내냐는 말을 썼다 지웠다 했어. 보내고 나니 별것 아닌데.",
            "expression": "neutral",
            "kind": "dialogue"
          }
        ],
