        "expression": "neutral"
      }
    ],
    "rein_ledger13": [
      {
        "id": "NW_RL_01",
        "speaker": "실룩",
        "kind": "dialogue",
        "text": "두 배를 왜 줬겠어요. 3번이니까요. 그 아래 누가 자는지 마을 사람 다 알아요.",
        "expression": "neutral"
