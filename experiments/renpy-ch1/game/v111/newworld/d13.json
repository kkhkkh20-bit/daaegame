{
  "replace": {
    "MS14_D13_S03_L0010": {
      "text": "그렇소. 어젯밤, 학교 종이 울릴 무렵에 모과를 보고 왔소."
    },
    "MS14_D13_S01_L0005": {
      "text": "이게 있긴 한데…… 에휴, 끝이 터졌어요. 당기면 솜만 나오겠네.",
      "expression": "anxious"
    },
    "MS14_D13_S01_L0016": {
      "text": "다 됐으면 주세요. 판돌 씨한테 가져갈게요. 아이고, 허리야…….",
      "expression": "anxious"
    },
    "MS14_D13_S01_L0017": {
      "text": "응? 내 거? 내 거 아니오. 나중에 다른 사람도 써야지.",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0006": {
      "text": "서류부터 보오. 머물 자리를 정해 받아야 하오. 밤에도 경비가 쓰는 곳이라 따뜻하오. 오늘 밤 쓸 몫은 확인했소."
    },
    "MS14_D13_S02_L0013": {
      "text": "부인도 명단에 있소. 여기 적혀 있소."
    },
    "MS14_D13_S04_L0012": {
      "text": "서류부터 보오. 내가 맡을 분들 이름하고, 머물 자리부터 확인하겠소."
    },
    "MS14_D13_S04_L0025": {
      "text": "에이…… 나도 내린다더니.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0030": {
      "text": "……다 들려요.",
      "expression": "angry"
    },
    "MS14_D13_S04_L0076": {
      "text": "……늦었어요.",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0039": {
      "text": "이미 데려가기로 정해졌소. 앉으시오."
    },
    "MS14_D13_S04_L0057": {
      "text": "내가 데려다주고 올게요. 다녀올게요.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0083": {
      "text": "안 해요. 환자나 짐은 옮겨도…… 사람 묶어서 데려가는 건 안 맡아요."
    },
    "MS14_D13_S04_L0085": {
      "text": "비웠어요. 자, 여기서 받아요.",
      "expression": "anxious"
    },
    "MS14_D13_B_L0002": {
      "text": "더 태울 자리가 없어요. 먼저 실은 사람 내려놓고 와야 해요.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0004": [
      {
        "text": "……판돌 씨가 내리겠다고 하지 않았소. 확인할 때까진 못 가오.",
        "when": "blanket_partial",
        "expression": "angry"
      },
      {
        "text": "촌장님은 모과 씨를 만난 적이 없소. 확인할 때까진 이 수레 못 가오.",
        "expression": "angry"
      }
    ],
    "MS14_D13_S04_L0014": {
      "text": "내가 여기 있겠소. 내려올 사람부터 받아 주시오."
    },
    "MS14_D13_S01_L0002": {
      "text": "문 좀 닫아 주시오. 잠깐이면 되오.",
      "expression": "anxious"
    },
    "MS14_D13_S01_L0003": {
      "text": "아빠, 저 아저씨 몸이 떨려.",
      "expression": "anxious"
    },
    "MS14_D13_S01_L0004": {
      "text": "까로 씨. 덮을 것, 하나라도 남았어요?"
    },
    "MS14_D13_S01_L0007": {
      "text": "이쪽 좀 대 줄래, 다람아?"
    },
    "MS14_D13_S01_L0008": {
      "text": "이 천? 여기 대면 돼?",
      "expression": "surprise"
    },
    "MS14_D13_S01_L0009": {
      "text": "응. 바늘 안 닿는 쪽으로 잡고."
    },
    "MS14_D13_S01_L0011": {
      "text": "어라, 새가 아래를 보는데?"
    },
    "MS14_D13_S01_L0012": {
      "text": "먹이 먹는 거야!",
      "expression": "angry",
      "fx": "jolt"
    },
    "MS14_D13_S01_L0013": {
      "text": "아아, 먹이. 아빠가 몰랐네."
    },
    "MS14_D13_S01_L0014": {
      "text": "새도 밥 먹어. 아빠만 먹는 줄 알아?",
      "expression": "angry"
    },
    "MS14_D13_S01_L0018": {
      "text": "지금은 판돌 씨가 추우시잖아요. 덮고 계세요."
    },
    "MS14_D13_S01_L0020": {
      "text": "오늘은 우리 셋, 같이 움직일까?",
      "expression": "joy"
    },
    "MS14_D13_S01_L0021": {
      "text": "그래. 입구부터 가 보자. 길 얘기도 물어보고."
    },
    "MS14_D13_S01_L0022": {
      "text": "우리 오늘 가? 진짜?",
      "expression": "surprise"
    },
    "MS14_D13_S01_L0023": {
      "text": "갈 수 있는지부터 물어보자."
    },
    "MS14_D13_S02_L0002": {
      "text": "산길은 아직 막혀 있소. 마차는 못 지나가오."
    },
    "MS14_D13_S02_L0003": {
      "text": "그럼…… 걸어서도 못 가요?",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0004": {
      "text": "아이 데리고는 안 되오. 막힌 데까지 직접 보고 왔소.",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0005": {
      "text": "그럼 여기서 밤은 보낼 수 있습니까?"
    },
    "MS14_D13_S02_L0007": {
      "text": "우리 셋 다 누우면…… 아저씨는 어디 앉아?",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0008": {
      "text": "나는 저 의자에 앉으면 되오. 너희 아빠는 발을 좀 접어야겠지."
    },
    "MS14_D13_S02_L0010": {
      "text": "내일까지 약속할 순 없소. 남겨 둔 물자가 얼마나 되는지 다시 봐야 하오.",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0011": {
      "text": "……네. 오늘 밤까지만이군요."
    },
    "MS14_D13_S02_L0014": {
      "text": "나는 가겠다고 한 적 없어요.",
      "expression": "angry"
    },
    "MS14_D13_S02_L0015": {
      "text": "가겠다는 사람을 적은 명단이 아니오."
    },
    "MS14_D13_S02_L0017": {
      "text": "얘기해 봅시다. 입구에 머물 자리도, 세 사람 먹을 몫도 내주겠소. 부인 이름은 내가 빼지."
    },
    "MS14_D13_S02_L0018": {
      "text": "그럼 길도 열어 준다는 겁니까?"
    },
    "MS14_D13_S02_L0019": {
      "text": "길을 연다는 말은 아니오. 셋이 함께 물러나 기다리시오. 오늘 밤은 책임지겠소."
    },
    "MS14_D13_S02_L0020": {
      "text": "그 약속, 실제로 누가 지킵니까?"
    },
    "MS14_D13_S02_L0021": {
      "text": "출입은 내가 맡소. 먹을 것도 세 몫 있소. 여기서 부인을 데려가지 말라는 명령을 받으면, 내가 명단에 표시할 수 있소."
    },
    "MS14_D13_S02_L0022": {
      "text": "셋이 따뜻한 데서 자고, 아내 이름도 빠지는 거죠? ……저만 여기 남는 건 안 되고요?"
    },
    "MS14_D13_S02_L0023": {
      "text": "가족 셋이 다 물러나야 하오. 그게 조건이오."
    },
    "MS14_D13_S02_L0025": {
      "text": "나하고 다람이 있을 자리는 학교에 확인해 뒀어. 까로 씨가 데려다주면 돼.",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0026": {
      "text": "까로 씨까지 가면…… 여기 수레는 누가 맡지?"
    },
    "MS14_D13_S02_L0027": {
      "text": "그러네. 까로 씨가 못 가면…… 다람이랑 같이 걸어 줄 사람을 찾아볼게.",
      "expression": "anxious"
    },
    "MS14_D13_S02_L0029": {
      "text": "내일도 여기 머물 수는 있습니까?"
    },
    "MS14_D13_S02_L0030": {
      "text": "오늘 밤만이오. 그 이상은 아니오."
    },
    "MS14_D13_S02_L0031": {
      "text": "아내 이름은 지금, 여기서 빼 주는 거죠?"
    },
    "MS14_D13_S02_L0032": {
      "text": "명단에 적겠소. 너울에게도 직접 보이겠소."
    },
    "MS14_D13_S02_L0038": {
      "text": "우리 셋은 물러나겠습니다. 먼저 아내 이름부터 빼 주세요."
    },
    "MS14_D13_S02_L0039": {
      "text": "돌목. 약속한 것부터 내주시오."
    },
    "MS14_D13_S02_L0034": {
      "text": "셋 다 돌아가시오. 여기서 빠지라는 말이오.",
      "expression": "angry"
    },
    "MS14_D13_S03_L0002": {
      "text": "판돌 씨. 잠깐 내려서 얘기 좀 해요."
    },
    "MS14_D13_S03_L0003": {
      "text": "안 되오. 또 엇갈리면…… 안 돼.",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0004": {
      "text": "누가 기다리고 있습니까?"
    },
    "MS14_D13_S03_L0005": {
      "text": "모과요. 내 아내. 나보고 오라던데…….",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0006": {
      "text": "아내분한테 직접 들으셨어요?"
    },
    "MS14_D13_S03_L0007": {
      "text": "촌장이 전해 줬소. 이번에는…… 만나야 하오.",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0009": {
      "text": "촌장님. 직접 만나고 오셨습니까?"
    },
    "MS14_D13_S03_L0011": {
      "text": "판돌 씨에게 오라고, 그렇게 말했고요?"
    },
    "MS14_D13_S03_L0013": {
      "text": "늘 그랬소. 자기는 괜찮다고…….",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0015": {
      "text": "그런데 이 담요, 오늘 아침에는 학교에 있었는데요."
    },
    "MS14_D13_S03_L0016": {
      "text": "다시 가져왔으니 그렇지. 남편부터 챙겨 달라는 거요."
    },
    "MS14_D13_S03_L0019": {
      "text": "그 새는…… 오늘 아침에 제가 붙였습니다."
    },
    "MS14_D13_S03_L0020": {
      "text": "…….",
      "expression": "flustered"
    },
    "MS14_D13_S03_L0021": {
      "text": "내가 천 잡아 줬어. 그거, 뒤집힌 게 아니야. 먹이 먹는 거야.",
      "expression": "angry"
    },
    "MS14_D13_S03_L0022": {
      "text": "어젯밤엔 이 담요에 그 새가 없었습니다. 모과 씨가 그걸 보고 웃었다는 건 맞지 않아요."
    },
    "MS14_D13_S03_L0023": {
      "text": "비슷한 담요를 봤겠지. 새 무늬 하나를 어떻게 일일이…….",
      "expression": "flustered"
    },
    "MS14_D13_S03_L0024": {
      "text": "방금, 판돌 씨가 두른 바로 이 담요라고 하셨잖습니까."
    },
    "MS14_D13_S03_L0025": {
      "text": "날짜가…… 헷갈렸나 보군.",
      "expression": "flustered"
    },
    "MS14_D13_S03_L0026": {
      "text": "오늘 아침에 생긴 새입니다. 그걸 어젯밤에 보여 줬다고 하셨어요."
    },
    "MS14_D13_S03_L0027": {
      "text": "한나절, 하루…… 그게 그렇게 중요하오?",
      "expression": "angry"
    },
    "MS14_D13_S03_L0028": {
      "text": "판돌 씨는 아내가 기다린다는 말을 믿고 타셨어요. 그 말을 믿어도 되느냐고 묻잖습니까. 왜 날짜쯤이라고 하세요."
    },
    "MS14_D13_S03_L0030": {
      "text": "그럼 모과가 이걸 보고…… 나 오라고 했다는 건?",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0031": {
      "text": "적어도…… 어젯밤 이 새를 보고 했다는 말은 사실일 수 없습니다."
    },
    "MS14_D13_S03_L0032": {
      "text": "그래도…… 나 기다리오?",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0035": {
      "text": "그럼 언제…… 만날 수 있소?",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0036": {
      "text": "저도 아내가 부른다는 말만 믿고 딸 데리고 왔어요. 그냥 타시라는 말은…… 못 하겠습니다. 일단 내려와요. 지금은."
    },
    "MS14_D13_S03_L0038": {
      "text": "내리겠소. 우선…… 내리겠소.",
      "expression": "anxious"
    },
    "MS14_D13_S03_L0043": {
      "text": "아침에 여기 있던 물건은 맞습니다. ……그전 일까지는 이것만으로 알 수 없겠네요."
    },
    "MS14_D13_S03_L0044": [
      {
        "text": "……그게 다요? 수레는 오래 기다리지 않소.",
        "when": "blanket_undecided"
      },
      {
        "text": "그러니 이제 길을 비키시오."
      }
    ],
    "MS14_D13_S03_L0045": {
      "text": "아침에…… 다람이랑 뭘 했는지 다시 떠올려 보자."
    },
    "MS14_D13_S04_L0002": {
      "text": "잠깐. 거기 서시오."
    },
    "MS14_D13_S04_L0003": {
      "text": "비켜.",
      "expression": "angry"
    },
    "MS14_D13_S04_L0011": {
      "text": "돌목 씨. 환자들이 어디로 가는지, 같이 확인해 주시겠습니까?"
    },
    "MS14_D13_S04_L0013": {
      "text": "까로 씨 돌아올 때까지는 세워 둘 수 있습니까?"
    },
    "MS14_D13_S04_L0063": {
      "text": "다람이 곁에 붙어 있어. 수레 쪽엔 오지 말고."
    },
    "MS14_D13_S04_L0064": {
      "text": "응. 여기서 다람이만 보고 있을게.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0058": {
      "text": "……아빠도 와.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0060": {
      "text": "네로 씨. 아내하고 다람이를 학교까지 같이 데려가 주시겠어요?"
    },
    "MS14_D13_S04_L0061": {
      "text": "그러지요. 자, 내가 아는 길로 갑시다."
    },
    "MS14_D13_S04_L0062": {
      "text": "도착해서 기다릴게. 당신도 와.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0016": {
      "text": "판돌 씨, 여기요. 제 어깨 놓지 마세요."
    },
    "MS14_D13_S04_L0017": {
      "text": "발판이…… 안 보여.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0018": {
      "text": "여기요. 발 조금만 앞으로요."
    },
    "MS14_D13_S04_L0021": {
      "text": "판돌 씨. 학교 안쪽으로 모실게요.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0022": {
      "text": "이 담요는…… 가져가도 되오?",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0023": {
      "text": "네. 그대로 덮고 계세요."
    },
    "MS14_D13_S04_L0066": {
      "text": "아래에서…… 잡고 있어?",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0068": {
      "text": "모모 씨, 여기 자리 있어요. 안으로 오세요.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0069": {
      "text": "굴돌 씨도 내려오세요. 학교에 자리 있어요."
    },
    "MS14_D13_S04_L0070": {
      "text": "이쪽 발부터 놓겠소. 좀 받쳐 주시오.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0071": {
      "text": "여기 앉아요. 젖은 건 벗어 두세요.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0040": {
      "text": "내 손…… 좀 펴 주시오.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0034": {
      "text": "오늘 밤이야…… 어찌어찌 넘기겠지."
    },
    "MS14_D13_S04_L0035": {
      "text": "내일 모자랄 건 내일 같이 따져야죠. 지금 사람을 실어 보내겠다는 답 말고요.",
      "expression": "angry"
    },
    "MS14_D13_S04_L0037": {
      "text": "그 말을…… 언제까지 할 수 있을까."
    },
    "MS14_D13_S04_L0088": {
      "text": "내일 일은 저도 모르겠어요. 그렇다고 오늘 이 사람들을 다시 태울 순 없잖습니까."
    },
    "MS14_D13_S04_L0072": {
      "text": "선생님도 내립니다. 아이들 있는 쪽으로는 보내지 마세요."
    },
    "MS14_D13_S04_L0073": {
      "text": "……학교로 가나요?",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0074": {
      "text": "따로 마련한 자리로 가오. 계속 지켜보겠소."
    },
    "MS14_D13_S04_L0008": {
      "text": "돌목 씨. 실룩 씨는 원래 있던 곳으로 데려가 맡아 주실 수 있습니까?"
    },
    "MS14_D13_S04_L0009": {
      "text": "내가 지켜보겠소. 그러면 지금 다른 환자를 받으러 갈 순 없소."
    },
    "MS14_D13_S04_L0026": {
      "text": "지금 내리시오. 발판 보고."
    },
    "MS14_D13_S04_L0031": {
      "text": "손, 이쪽으로 주시오."
    },
    "MS14_D13_S04_L0032": {
      "text": "……그럼 잡아 주든가.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0075": {
      "text": "실룩 씨. 이쪽으로 손 주세요."
    },
    "MS14_D13_S04_L0077": {
      "text": "발판을 보시오. 내려도 계속 지켜볼 거요."
    },
    "MS14_D13_S04_L0028": {
      "text": "아빠…… 저 아저씨 싫어하잖아.",
      "expression": "anxious"
    },
    "MS14_D13_S04_L0029": {
      "text": "……싫지."
    },
    "MS14_D13_S04_L0044": {
      "text": "내일 새 명단이 오면…… 또 태울 겁니까?"
    },
    "MS14_D13_S04_L0080": {
      "text": "아내 이름만 빼 달라는 게 아닙니다. 이 명령, 전부 멈춰 주세요."
    },
    "MS14_D13_S04_L0081": {
      "text": "명령 전체를 멈춘다고 적겠소. 입구에서도 받지 않겠소."
    },
    "MS14_D13_S04_L0084": {
      "text": "제 수레 맞습니다. 이런 일에는 다시 안 빌려줍니다."
    },
    "MS14_D13_S04_L0086": {
      "text": "사람 묶던 것만 따로 표시했소. 담요와 물자 묶는 끈은 그대로요."
    },
    "MS14_D13_A_L0002": {
      "text": "우리 셋은 물러날게요. 대신 오늘 밤 잘 자리, 밥 세 몫. 아내는 안 데려간다는 것까지 지금 확인해 주세요."
    },
    "MS14_D13_A_L0005": {
      "text": "그럼…… 저 아저씨는?",
      "expression": "anxious"
    },
    "MS14_D13_A_L0007": {
      "text": "……아빠는 안 맡아?",
      "expression": "anxious"
    },
    "MS14_D13_A_L0008": {
      "text": "오늘은…… 너희하고 갈 거야."
    },
    "MS14_D13_A_L0010": {
      "text": "먹어. 당신부터 먹어.",
      "expression": "anxious"
    },
    "MS14_D13_A_L0011": {
      "text": "다람이 먼저 주고……."
    },
    "MS14_D13_A_L0012": {
      "text": "세 몫이야. 당신 것도 있어.",
      "expression": "anxious"
    },
    "MS14_D13_A_L0014": {
      "text": "……여긴 따뜻해.",
      "expression": "anxious"
    },
    "MS14_D13_A_L0015": {
      "text": "……응."
    },
    "MS14_D13_A_L0016": {
      "text": "우리만…… 따뜻해?",
      "expression": "anxious"
    },
    "MS14_D13_A_L0018": {
      "text": "학교에도 있어. 거기까지 데려온 사람들은……."
    },
    "MS14_D13_B_L0003": {
      "text": "나는…… 이 사람 두고 못 가오.",
      "expression": "anxious"
    },
    "MS14_D13_B_L0004": {
      "text": "그럼 수레는 여기 둡시다. 우선 담요부터 가져와요."
    },
    "MS14_D13_B_L0005": {
      "text": "여기가…… 대피소요?"
    },
    "MS14_D13_B_L0006": {
      "text": "아직은 출발지도 아니오."
    },
    "MS14_D13_B_L0008": {
      "text": "나는 여기 앉아도 되오. 저 사람 눕힐 자리부터 만드시오.",
      "expression": "anxious"
    },
    "MS14_D13_B_L0009": {
      "text": "떠나지 않도록…… 옆에 있겠습니다."
    },
    "MS14_D13_C_L0002": {
      "text": "우리 아버지도…… 네가 태웠지.",
      "expression": "angry"
    },
    "MS14_D13_C_L0003": {
      "text": "손 놔.",
      "expression": "angry"
    },
    "MS14_D13_C_L0006": {
      "text": "아빠…… 저 사람, 지금 때려.",
      "expression": "anxious"
    },
    "MS14_D13_C_L0009": {
      "text": "손 놓으세요. 아직 이 사람한테 물어볼 게 있어요."
    },
    "MS14_D13_C_L0010": {
      "text": "우리한테는 물어봤어? 누구를 데려갈지.",
      "expression": "angry"
    },
    "MS14_D13_C_L0011": {
      "text": "그래도 여기서 때리진 마요. 비켜요."
    },
    "MS14_D13_C_L0013": {
      "text": "비켜요. 다람아, 엄마 옆에 있어."
    },
    "MS14_D13_C_L0015": {
      "text": "놓으라니까…….",
      "expression": "angry"
    },
    "MS14_D13_C_L0016": {
      "text": "묻는 말에 대답할 때까지…… 여기 있어요."
    },
    "MS14_D13_C_L0017": {
      "text": "돌목 씨. 이 사람부터 막아 주세요."
    },
    "MS14_D13_C_L0018": {
      "text": "물러서시오. 때리지 마시오.",
      "expression": "angry"
    },
    "MS14_D13_C_L0020": {
      "text": "놔. 손 놓으라고.",
      "expression": "angry"
    },
    "MS14_D13_C_L0021": {
      "text": "밀지 마요. 아이도 있어요."
    },
    "MS14_D13_C_L0022": {
      "text": "비켜.",
      "expression": "angry"
    }
  },
