  "bindings": [
    {
      "person": "bami",
      "slot": "small_relief",
      "identity": "ep2:bami:blanket",
      "index": 1,
      "text": "……이거 너네 아빠 거지? 따뜻하다.",
      "key": "bami:small_relief"
    },
    {
      "person": "resident_lamplighter",
      "slot": "guarded_relief",
      "identity": "nt:night8:safe",
      "index": 3,
      "text": "직접 전해 드린다고 했잖아요.",
      "key": "resident_lamplighter:guarded_relief"
    },
    {
      "person": "kid_kkomi",
      "slot": "resilient_pride",
      "identity": "wf:morning:alive",
      "index": 1,
      "text": "우리 집 다 탔어. ……근데 대장은 표시 안 잃어버렸다.",
      "key": "kid_kkomi:resilient_pride"
    },
    {
      "person": "resident_tosil",
      "slot": "empathetic_confusion",
      "identity": "cv:altar:granny",
      "index": 7,
      "text": "……할머니. 여기가 산 너머야?",
      "key": "resident_tosil:empathetic_confusion"
    }
  ]
